---
layout: base.njk
title: Info
description: "About and contact: Yousri Cherif, portrait and fashion photographer based between Munich and Tunis."
---
    <main class="grid page">
      <div class="info">
        <section>
          <h2 class="label">About</h2>
          {%- for paragraph in info.about | paragraphs %}
          <p>{{ paragraph }}</p>
          {%- endfor %}
          <p><a href="https://www.instagram.com/{{ info.instagram }}/" target="_blank" rel="noopener">@{{ info.instagram }}</a></p>
        </section>

        <section>
          <h2 class="label">Contact</h2>
          <p><a href="mailto:{{ info.email }}">{{ info.email }}</a></p>
          <p>{{ info.contactNote }}</p>
        </section>

        {#- Remove "hidden" when there are 3+ clients. #}
        <section hidden>
          <h2 class="label">Selected clients</h2>
          <p>Rhimi Paris</p>
        </section>
      </div>
    </main>

    <p class="bottom">© {{ currentYear }}</p>
